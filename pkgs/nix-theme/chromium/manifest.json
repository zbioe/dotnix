{
  "manifest_version": 3,
  "name": "nix-theme",
  "description": "Follows the active dotnix theme and fonts in Dark Reader and while pages load.",
  "version": "1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "fontSettings"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
