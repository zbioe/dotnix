{
  "manifest_version": 2,
  "name": "nix-theme",
  "description": "Follows the active dotnix theme: browser colors and Dark Reader.",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "nix-theme@dotnix"
    }
  },
  "permissions": [
    "theme",
    "nativeMessaging",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
