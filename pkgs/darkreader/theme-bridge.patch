+    // dotnix: theme updates pushed by the nix-theme extension (and only by it:
+    // its Firefox id and its fixed Chromium id, pkgs/nix-theme)
+    static readonly THEME_BRIDGE_IDS = ['nix-theme@dotnix', 'fafnnenadbigcbhmihefjbaiggflgefj'];
+
+    static initThemeBridge(): void {
+        chrome.runtime.onConnectExternal.addListener((port) => {
+            if (!Messenger.THEME_BRIDGE_IDS.includes(port.sender?.id ?? '')) {
+                port.disconnect();
+                return;
+            }
+            port.onMessage.addListener(({type, data}: {type: string; data: any}) => {
+                switch (type) {
+                    case 'setTheme':
+                        Messenger.adapter.setTheme(data);
+                        break;
+                    case 'changeSettings':
+                        Messenger.adapter.changeSettings(data);
+                        break;
+                }
+            });
+        });
+    }
