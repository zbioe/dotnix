# Browsers following `theme` live (home/theme). LibreWolf: the nix-theme
# bridge recolors the browser and drives a patched Dark Reader, both add-ons
# from the store through policies. Chromium (and Brave, home/ui/default.nix):
# the same pair unpacked from the store, loaded by the wrapper; the UI itself
# follows GTK.
{
  config,
  pkgs,
  unstable,
  ...
}:
let
  darkreader = pkgs.callPackage ../pkgs/darkreader { };
  nixTheme = pkgs.callPackage ../pkgs/nix-theme {
    themeSet = import ../home/theme/themes.nix { inherit pkgs; };
    inherit (config.stylix.base16) mkSchemeAttrs;
  };

  librewolf = unstable.librewolf.override {
    nativeMessagingHosts = [ nixTheme ];
    # both add-ons are built here, so they are unsigned
    extraPrefs = ''
      lockPref("xpinstall.signatures.required", false);
    '';
    extraPolicies.ExtensionSettings = {
      ${darkreader.addonId} = {
        installation_mode = "force_installed";
        install_url = "file://${darkreader}/darkreader.xpi";
        # keep AMO from replacing it with the unpatched release
        updates_disabled = true;
      };
      ${nixTheme.addonId} = {
        installation_mode = "force_installed";
        install_url = "file://${nixTheme}/nix-theme.xpi";
      };
    };
  };

  webuiTheme = pkgs.callPackage ../pkgs/webui-theme { };

  # its own pages in the palette too (pkgs/webui-theme). Only the last
  # --enable/--disable-features counts, so the wrapper's list is repeated.
  chromium = webuiTheme.chromium (
    unstable.chromium.override {
      commandLineArgs = [
        "--load-extension=${darkreader}/chromium,${nixTheme}/chromium"
        # Chromium dropped --load-extension from its defaults
        "--disable-features=DisableLoadExtensionCommandLineSwitch"
        # internal pages, and the focused address bar, built from the theme colors
        "--enable-features=WaylandWindowDecorations,WebuiRefresh2026,WebUIOmniboxPopup,WebUIOmniboxFullPopup"
      ];
    }
  );
in
{
  environment.systemPackages = [
    librewolf
    chromium
  ];
  environment.etc."chromium/native-messaging-hosts/nix_theme.json".source =
    "${nixTheme}/etc/chromium/native-messaging-hosts/nix_theme.json";

  # Brave live on `theme` (pkgs/brave-theme): Brave rereads its theme pack
  # from disk when its BrowserThemeColor policy is unset, so on each request
  # (the palette's background, written by `theme` to /run/nix-theme) this
  # sets the policy for a moment and takes it back. Brave waits 5 s for
  # policy files to settle unless the newest file time stays the same: the
  # placeholder (a store link, time 1) and the moved-in file share it.
  environment.etc."brave/policies/managed/nix-theme.json".text = "{}";
  systemd.tmpfiles.rules = [ "d /run/nix-theme 0755 ${config.modules.user.name} users -" ];
  systemd.paths.brave-theme-reload = {
    wantedBy = [ "paths.target" ];
    pathConfig.PathModified = "/run/nix-theme/brave-reload";
  };
  systemd.services.brave-theme-reload = {
    description = "Reload Brave's theme pack";
    serviceConfig.Type = "oneshot";
    script = ''
      color=$(head -c 7 /run/nix-theme/brave-reload)
      [[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || exit 0
      policy=/etc/brave/policies/managed/nix-theme-reload.json
      tmp=$(mktemp /etc/brave/.nix-theme-reload.XXXXXX)
      printf '{"BrowserThemeColor": "%s"}\n' "$color" > "$tmp"
      chmod 644 "$tmp"
      touch -d @1 "$tmp"
      mv -f "$tmp" "$policy"
      sleep 0.5 # applied (an autogenerated theme of that color)
      rm -f "$policy"
    '';
  };
}
