+void PowerTab::commitChargeLimits(std::size_t rowIndex, bool startChanged) {
+  if (rowIndex >= m_chargeLimitRows.size() || m_upower == nullptr) {
+    return;
+  }
+  auto& row = m_chargeLimitRows[rowIndex];
+  int start = row.startStepper->value();
+  int end = row.endStepper->value();
+  // the start always below the end: the other one moves out of the way
+  if (start >= end) {
+    if (startChanged) {
+      end = std::min(100, start + 5);
+      row.endStepper->setValue(end);
+    } else {
+      start = std::max(20, end - 5);
+      row.startStepper->setValue(start);
+    }
+  }
+  if (start == row.shownStart && end == row.shownEnd) {
+    return;
+  }
+  row.shownStart = start;
+  row.shownEnd = end;
+
+  // pkexec, not run0: the polkit rule lets the active session run this one
+  // helper without a password
+  UPowerService* upower = m_upower;
+  (void)process::runAsync(
+      std::string("/run/wrappers/bin/pkexec /run/current-system/sw/bin/dotnix-charge-limit-set ")
+          + std::to_string(start) + " " + std::to_string(end),
+      process::RunCallbacks{
+          .onExit = [upower](process::RunResult) { DeferredCall::callLater([upower] { upower->refresh(); }); },
+      }
+  );
+}
