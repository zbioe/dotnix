+namespace {
+  std::unordered_map<std::string, char32_t>& overrides() {
+    static std::unordered_map<std::string, char32_t> map;
+    return map;
+  }
+} // namespace
+
+void GlyphRegistry::setOverrides(std::string_view map) {
+  overrides().clear();
+  for (std::size_t start = 0; start < map.size();) {
+    const std::size_t end = std::min(map.find(',', start), map.size());
+    const std::string_view entry = map.substr(start, end - start);
+    if (const std::size_t eq = entry.find('='); eq != std::string_view::npos) {
+      if (auto cp = parseCodepointLiteral(entry.substr(eq + 1))) {
+        overrides()[std::string(entry.substr(0, eq))] = *cp | kOverrideBit;
+      }
+    }
+    start = end + 1;
+  }
+}
+
+char32_t GlyphRegistry::lookupOverridable(std::string_view name) {
+  const auto& map = overrides();
+  if (!map.empty()) {
+    const std::string key{name};
+    if (const auto it = map.find(key); it != map.end()) {
+      return it->second;
+    }
+    if (const auto alias = kAliases.find(key); alias != kAliases.end()) {
+      if (const auto it = map.find(std::string(alias->second)); it != map.end()) {
+        return it->second;
+      }
+    }
+  }
+  return lookup(name);
+}
