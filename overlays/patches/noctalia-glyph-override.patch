+void CairoGlyphRenderer::dropOverrideFont() {
+  if (m_overrideCairoFace != nullptr) {
+    cairo_font_face_destroy(m_overrideCairoFace);
+    m_overrideCairoFace = nullptr;
+  }
+  if (m_overrideFace != nullptr) {
+    FT_Done_Face(m_overrideFace);
+    m_overrideFace = nullptr;
+  }
+  m_overridePath.clear();
+}
+
+void CairoGlyphRenderer::setOverrideFont(const std::string& fontPath) {
+  if (fontPath == m_overridePath) {
+    return;
+  }
+  invalidateGlyphTextures();
+  dropOverrideFont();
+  if (fontPath.empty() || m_ftLibrary == nullptr) {
+    return;
+  }
+  if (FT_New_Face(m_ftLibrary, fontPath.c_str(), 0, &m_overrideFace) != 0) {
+    m_overrideFace = nullptr;
+    return;
+  }
+  m_overrideCairoFace = cairo_ft_font_face_create_for_ft_face(m_overrideFace, 0);
+  if (m_overrideCairoFace == nullptr || cairo_font_face_status(m_overrideCairoFace) != CAIRO_STATUS_SUCCESS) {
+    dropOverrideFont();
+    return;
+  }
+  m_overridePath = fontPath;
+}
+
+CairoGlyphRenderer::FaceFor CairoGlyphRenderer::faceFor(char32_t codepoint) const {
+  if ((codepoint & GlyphRegistry::kOverrideBit) != 0) {
+    return {m_overrideFace, m_overrideCairoFace, codepoint & ~GlyphRegistry::kOverrideBit};
+  }
+  return {m_face, m_cairoFace, codepoint};
+}
