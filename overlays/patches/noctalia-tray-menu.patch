+  // the menu of a tray item from anywhere (e.g. a widget's right click),
+  // anchored at the pointer like a click on the tray icon itself
+  m_ipcService.bind(noctalia::cli::msg::trayMenu, [this](const std::string& args) -> std::string {
+    const auto parts = noctalia::ipc::splitWords(args);
+    if (parts.size() != 1) {
+      return "error: tray-menu requires <item>\n";
+    }
+    if (m_trayService == nullptr) {
+      return "error: tray unavailable\n";
+    }
+    for (const auto& item : m_trayService->items()) {
+      if (item.id == parts[0] || tray::tokenMatchesItem(parts[0], item)) {
+        if (!m_trayService->itemUsesDBusMenu(item.id)) {
+          return "error: tray item has no menu\n";
+        }
+        m_trayService->requestMenuToggle(item.id, 1.0F);
+        return "ok\n";
+      }
+    }
+    return "error: no tray item '" + parts[0] + "'\n";
+  });
