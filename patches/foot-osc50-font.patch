+bool
+term_font_set(struct terminal *term, const char *pattern)
+{
+    struct config_font font;
+    if (!config_font_parse(pattern, &font))
+        return false;
+
+    free(term->font_override);
+    term->font_override = font.pattern;
+    term->font_sizes[0][0] = (struct config_font){
+        .pt_size = font.pt_size, .px_size = font.px_size};
+    return reload_fonts(term, true);
+}
